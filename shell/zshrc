#!/bin/zsh

# proxy
export PROXY_ENV=$HOME/.ssh/bin/proxy_env.sh
if [ -e $PROXY_ENV ]; then
    source $PROXY_ENV
fi

# setup
export WORKDIR=$HOME/work

os="$(uname -s)"
if [[ -n "$WSL_DISTRO_NAME" ]]; then
    export NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
    export SSH_AUTH_SOCK="$HOME/.ssh/bitwarden-ssh-agent.sock"
    sh "$HOME/.ssh/bin/bitwarden-ssh-agent.sh"
    open() { local reveal=false; if [[ "$1" == "-R" ]]; then reveal=true; shift; fi; local target="${1:-.}"; local win_target; win_target="$(wslpath -w "${target:A}")" || return 1; if [[ "$reveal" == true ]]; then explorer.exe /select, "$win_target"; else explorer.exe "$win_target"; fi; }
fi
if [[ "$os" == Darwin ]]; then
    export ZSH_PLUGIN="/opt/zerobrew/share"
    export PATH="/opt/zerobrew/sbin:$PATH"
    export PATH="/opt/zerobrew/bin:$PATH"
    export PATH="/opt/homebrew/sbin:$PATH"
    export PATH="/opt/homebrew/bin:$PATH"
    bindkey '^[[A' history-substring-search-up
    bindkey '^[[B' history-substring-search-down
    export SSH_AUTH_SOCK="$HOME/.bitwarden-ssh-agent.sock"
elif [[ "$os" == Linux ]]; then
    export ZSH_PLUGIN="$HOME/.local/share/zerobrew/prefix/share"
    export PATH="$HOME/.local/share/zerobrew/prefix/sbin:$PATH"
    export PATH="$HOME/.local/share/zerobrew/prefix/bin:$PATH"
    export PATH="$HOME/.homebrew/sbin:$PATH"
    export PATH="$HOME/.homebrew/bin:$PATH"
    bindkey "$terminfo[kcuu1]" history-substring-search-up
    bindkey "$terminfo[kcud1]" history-substring-search-down
fi

# settings
export XDG_CACHE_HOME=$HOME/.cache
export XDG_DATA_HOME=$HOME/.local/share
export XDG_STATE_HOME=$HOME/.local/state
export XDG_CONFIG_HOME=$HOME/.config
export PKG_CONFIG_PATH="$ZEROBREW_PREFIX/lib/pkgconfig:${PKG_CONFIG_PATH:-}"
export ZSH_AUTO=$ZSH_PLUGIN/zsh-autosuggestions/zsh-autosuggestions.zsh
export ZSH_AUTOPAIR=$ZSH_PLUGIN/zsh-autopair/autopair.zsh
export ZSH_SYNTAX=$ZSH_PLUGIN/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
export ZSH_HIST_SEARCH=$ZSH_PLUGIN/zsh-history-substring-search/zsh-history-substring-search.zsh
export ZSH_CMP=$ZSH_PLUGIN/zsh-completions
export EDITOR=nvim
export COLORTERM=truecolor
export APPLE_SSH_ADD_BEHAVIOR=macos
export LESSHISTFILE=$XDG_STATE_HOME/lesshst
export HISTFILE=$XDG_STATE_HOME/zsh_history
export STARSHIP_CONFIG=$XDG_CONFIG_HOME/starship/starship.toml
export MPLCONFIGDIR=$XDG_CACHE_HOME/matplotlib
export NPM_CONFIG_USERCONFIG=$XDG_CONFIG_HOME/node_js/npmrc
export IPYTHONDIR=$XDG_CACHE_HOME/ipython
export GIT_SSH_COMMAND="$(command -v ssh) -F $HOME/.ssh/config"
export HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_FOUND=false
export HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_NOT_FOUND=false
export PYTHONWARNINGS="ignore::UserWarning:IPython.core.interactiveshell"

mkdir -p "$XDG_STATE_HOME"
chmod 700 "$XDG_STATE_HOME"
touch "$HISTFILE"
chmod 600 "$HISTFILE"

if [ -e "$ZSH_CMP" ]; then fpath=($ZSH_CMP $fpath); else echo "zsh-completions not found"; fi
autoload -Uz compinit && compinit
autoload -Uz add-zsh-hook
compdef _diff delta

if [ ! -e "$HISTFILE" ]; then mkdir -p "$(dirname "$HISTFILE")" && touch "$HISTFILE"; fi
if [ -e "$ZSH_AUTO" ]; then source $ZSH_AUTO; else echo "zsh-autosuggestions not found"; fi
if [[ -e "$ZSH_HIST_SEARCH" ]]; then source "$ZSH_HIST_SEARCH"; else echo "zsh-history-substring-search not found"; fi
if [ -e "$ZSH_AUTOPAIR" ]; then source $ZSH_AUTOPAIR; else echo "zsh-autopair not found"; fi
if [ -e "$ZSH_SYNTAX" ]; then source $ZSH_SYNTAX; else echo "zsh-syntax-highlighting not found"; fi

# options
HISTSIZE=100000
SAVEHIST=100000
setopt prompt_subst
setopt +o nonomatch
setopt share_history
setopt append_history
setopt auto_param_slash
setopt mark_dirs
setopt interactive_comments
setopt magic_equal_subst
setopt complete_in_word
setopt hist_ignore_all_dups
setopt hist_ignore_space
setopt hist_reduce_blanks
setopt hist_no_store
blank_line_before_command_output() { print; }
add-zsh-hook preexec blank_line_before_command_output
cd $WORKDIR

# git
alias gs="git status -s --ignored"
alias gp="git pull --rebase"
alias ga="git add"
alias gP="git push"
alias gS="git stash push"
alias gc="git commit"
alias go="git checkout"
alias gb="git branch"
alias gd="git diff"
alias gl="git log"
alias lg="lazygit"
alias gt='git add -A && git commit && git pull --rebase && git push'
alias gcl="git clean -fdX"
gn() { git clone "git@github.com:$1" "${@:2}"; }

# alias
alias c="clear"
alias cdr="cd $WORKDIR"
alias diff="delta"
alias mv="mv -i"
alias cp="cp -i -r"
alias lzd="lazydocker"
alias python="ipython"
alias grep="grep --color=auto -d skip"
alias lsgpu="watch -n 1 nvidia-smi"
alias pin="uv pip install"
alias bb="brew upgrade && cat '$XDG_CONFIG_HOME/homebrew/${os}_Brewfile.rb' | brew bundle --file=-"
alias zbb="cd $HOME/.config/homebrew && zb bundle && cd - >/dev/null;"
alias bbc="brew cleanup && cat '$XDG_CONFIG_HOME/homebrew/${os}_Brewfile.rb' | brew bundle cleanup --file=-"
alias checkpy='ruff check --fix --unsafe-fixes .; ruff format .; uv run pyright; uv run mypy .;'
alias cb="ln -sf .build/compile_commands.json compile_commands.json; cmake -S . -B .build -DCMAKE_EXPORT_COMPILE_COMMANDS=ON -G Ninja"
alias cdev="cmake --build .build -j 16"
alias latexindent="latexindent -s -w -c ~/.cache/latexindent **/*.tex"
bws() { export BW_SESSION="$(bw unlock --raw)"; }
cformat() { git ls-files -z -- '*.c' '*.cc' '*.cpp' '*.h' '*.hpp' | xargs -0 -r -P 2 -n 1 -t clang-format -i }
# vgrep uses Vim regex syntax (\\v enables very magic mode).
vgrep() (
    if (( $# == 0 )) || [[ -z "$1" ]]; then
        print -u2 'usage: vgrep VIM_PATTERN [PATH ...]'
        return 2
    fi
    local pattern="$1"
    shift
    local files tracked=0
    files=$(mktemp "${TMPDIR:-/tmp}/vgrep.XXXXXXXX") || return 2
    trap 'command rm -f -- "$files"' EXIT
    if git rev-parse --show-toplevel >/dev/null 2>&1; then
        tracked=1
        git ls-files -z -- "$@" > "$files" || return 2
    else
        if (( $# == 0 )); then
            set -- .
        fi
        # Prefix relative paths so find does not interpret them as expressions.
        local path
        local -a paths
        for path in "$@"; do
            [[ "$path" == /* ]] || path="./$path"
            paths+=("$path")
        done
        command find -H "${paths[@]}" -type f -print0 > "$files" || return 2
    fi
    VGREP_PATTERN="$pattern" VGREP_FILES="$files" VGREP_TRACKED="$tracked" \
        nvim -S "${XDG_CONFIG_HOME:-$HOME/.config}/nvim/vgrep.vim"
)
sshbw() { SSH_ASKPASS="$HOME/.ssh/bin/bitwarden-askpass.sh" SSH_ASKPASS_REQUIRE=force ssh "$@" }
compdef sshbw=ssh
if hash starship 2>/dev/null; then eval "$(starship init zsh)"; else echo "starship not found"; fi
if hash eza 2>/dev/null; then alias ls="eza -g --icons --sort Name"; else echo "eza not found"; fi
if hash eza 2>/dev/null; then alias la="eza -a -g --icons --sort Name"; else alias la="ls -a"; fi
if hash eza 2>/dev/null; then alias ll="eza -l -a -g --icons --sort Name"; else alias ll="ls -la"; fi
if hash eza 2>/dev/null; then alias lt="eza -T --git-ignore --sort Name"; fi
if hash bat 2>/dev/null; then alias cat="bat -p --paging=never --theme 'Visual Studio Dark+'"; else echo "bat not found"; fi
if hash htop 2>/dev/null; then alias top="htop"; else echo "htop not found"; fi
if hash nvim 2>/dev/null; then alias vim="nvim -O"; else echo "nvim not found"; fi
if hash rip 2>/dev/null; then alias rm="rip"; else echo "rip2 not found"; fi
if hash pbcopy >/dev/null 2>&1 || hash xclip >/dev/null 2>&1 || hash clip >/dev/null 2>&1; then :; else echo " clip command not found"; fi
if hash nohup >/dev/null 2>&1; then detach() { local cmd="$*"; nohup bash -c 'cmd="$1"; shift; "$@"; status=$?; ~/.ssh/bin/notify.sh "$cmd end"; exit "$status"' _ "$cmd" "$@" >nohup_$(date +%Y%m%d_%H%M%S).log 2>&1 </dev/null &| }; fi
if hash podman >/dev/null 2>&1; then podman_socket=$(podman machine inspect --format '{{.ConnectionInfo.PodmanSocket.Path}}' 2>/dev/null); if [[ -n "$podman_socket" ]]; then export DOCKER_HOST="unix://$podman_socket"; fi; unset podman_socket; fi
